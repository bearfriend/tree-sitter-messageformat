{
  "name": "tree-sitter-messageformat",
  "version": "0.2.0",
  "description": "messageformat parser",
  "repository": "https://github.com/bearfriend/tree-sitter-messageformat",
  "license": "MIT",
  "author": {
    "name": "Danny Gleckler",
    "email": "daniel.gleckler@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "messageformat"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "message/grammar.js",
    "message/src/**",
    "message/queries/*",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js && tree-sitter test && npm run test:message",
    "test:grammar": "tree-sitter test",
    "test:message": "cd message && tree-sitter test",
    "generate": "tree-sitter generate && cd message && tree-sitter generate",
    "build": "tree-sitter build",
    "highlight": "tree-sitter highlight"
  }
}
