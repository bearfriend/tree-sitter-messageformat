{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "messageformat",
      "camelcase": "MessageFormat",
      "title": "messageformat",
      "scope": "source.messageformat",
      "file-types": [
        "mf",
        "mf.js",
        "mf.json",
        "msg",
        "messages"
      ],
      "injection-regex": "^messageformat$",
      "class-name": "TreeSitterMessageformat",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "path": "."
    },
    {
      "name": "messageformat_message",
      "camelcase": "MessageFormatMessage",
      "title": "messageformat message",
      "scope": "source.messageformat.message",
      "path": "message",
      "file-types": [],
      "injection-regex": "^messageformat_message$",
      "class-name": "TreeSitterMessageformatMessage",
      "highlights": "message/queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "messageformat parser",
    "authors": [
      {
        "name": "Danny Gleckler",
        "email": "daniel.gleckler@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/bearfriend/tree-sitter-messageformat"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
